# ─────────────────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────────────────
# Backend root URL — no trailing slash, no /api suffix.
# Leave UNSET in development: Vite's dev server proxies /api to localhost:3001.
# Required in production (Railway, Coolify, etc.):
# VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (src/shared/lib/featureFlags.ts)
# Read at BUILD time, not runtime — changing one requires a rebuild.
# ─────────────────────────────────────────────────────────────────────────────
# Tags on boards. ON unless explicitly set to 'false'.
VITE_BOARDS_TAGS_ENABLED=true

# Vocabulary import. ON unless explicitly set to 'false'.
VITE_IMPORT_ENABLED=true

# Legacy theme variant picker. OFF unless explicitly set to 'true'.
VITE_LEGACY_THEMES_ENABLED=false
