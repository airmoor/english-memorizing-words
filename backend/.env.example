# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnenglish

# Alternatively, use individual connection params:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnenglish
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change-me-secret

# App
PORT=3001
NODE_ENV=development
# Merriam-Webster Learner's Dictionary API (primary dictionary provider)
# Register at: https://dictionaryapi.com/register/index
# If unset, the backend silently falls back to the Free Dictionary API.
MERRIAM_API_KEY=
