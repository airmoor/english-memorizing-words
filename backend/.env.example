# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# On Railway: DATABASE_URL is auto-injected. You do not set it manually.
# Locally: use DATABASE_URL OR the individual DB_* vars (not both).
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/learnenglish

# Individual vars (used only if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnenglish
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# JWT — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be different values.
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_strong_random_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Required when NODE_ENV=production. Omitting it will throw at startup.
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# THIRD-PARTY APIs
# ─────────────────────────────────────────────────────────────────────────────
# Merriam-Webster Learner's Dictionary API
# Register at: https://dictionaryapi.com/register/index
# Falls back to Free Dictionary API if unset.
MERRIAM_API_KEY=

# DeepL translation API (word translations / native-language gloss)
# Register at: https://www.deepl.com/pro-api
# Free tier: a one-time credit of 1,000,000 characters (DeepL's current model).
# Free-tier keys end with ':fx' (the app auto-detects the api-free host).
# When unset, translation endpoints return 503 ("No translation provider available").
DEEPL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PRONUNCIATION AUDIO — provider cascade + S3/MinIO object storage
# ─────────────────────────────────────────────────────────────────────────────
# Audio is resolved once per (word, accent), then cached forever in object
# storage and served from PRONUNCIATION_CDN_BASE_URL. Sources, in order:
#
#   1. Merriam-Webster — human recordings at learner pace, US only.
#      Uses MERRIAM_API_KEY above. Free, no card. Non-commercial terms and
#      attribution required — the API returns the credit string to display.
#   2. Free Dictionary — human recordings from Wiktionary (CC BY-SA). No key.
#      Coverage is partial.
#   3. Amazon Polly — neural TTS, covers everything, needs a card. OPTIONAL:
#      leave the AWS_* vars empty and the cascade simply ends at step 2.
#
# Endpoint status codes: 404 = every source answered and none has a recording;
# 503 = no source is configured, or the sources could not be reached.
#
# Polly needs REAL AWS credentials (these do NOT work against MinIO):
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional voice overrides (defaults: US=Joanna, UK=Amy, AU=Olivia):
POLLY_US_VOICE=Joanna
POLLY_UK_VOICE=Amy

# Object storage. Local dev uses MinIO (its own creds, S3_* below). In prod,
# leave S3_ENDPOINT + S3_* unset to use real AWS S3 with the AWS_* creds above,
# and point PRONUNCIATION_CDN_BASE_URL at your CloudFront distribution.
S3_BUCKET=learnenglish-audio
# MinIO endpoint as seen by the backend (host: http://localhost:9000;
# inside docker-compose: http://minio:9000). Leave UNSET for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# MinIO root credentials (dev only). Unset in prod so storage falls back to AWS_*.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Grant anonymous read on the bucket so the browser can fetch audio by URL.
# Dev/MinIO: true. Prod: leave false and front a private bucket with CloudFront.
S3_PUBLIC_READ=true
# Browser-facing base URL for audio (MinIO host mapping in dev, CloudFront in prod).
# MUST be https in production: the app itself is served over https, and browsers
# block http media on an https page as mixed content — the player would fail
# silently with nothing but a console warning.
PRONUNCIATION_CDN_BASE_URL=http://localhost:9000/learnenglish-audio
