# Database
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/learnenglish

# Alternatively, use individual connection params:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learnenglish
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# JWT — generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be different values.
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_strong_random_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development

# Required in production (NODE_ENV=production)
FRONTEND_URL=http://localhost:5173

# Merriam-Webster Learner's Dictionary API (primary dictionary provider)
# Register at: https://dictionaryapi.com/register/index
# If unset, the backend silently falls back to the Free Dictionary API.
MERRIAM_API_KEY=
